# Copier en .env pour surcharger les valeurs de développement (facultatif avec docker compose).
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://daara:daara@db:5432/daara
REDIS_URL=redis://redis:6379/0

# Langues actives (spec §5.2) : ajouter « wo » ici pour activer le wolof.
DAARA_LANGUAGES=fr,en
DAARA_DEFAULT_LANGUAGE=en

# Chemin de l'administration Django, à changer en production.
ADMIN_URL=admin/
